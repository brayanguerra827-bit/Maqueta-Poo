-- ==========================================
-- ESTRUCTURA Y DATOS INICIALES - PETCARE WEB
-- Base de Datos: SQL Server
-- ==========================================

-- 1. TABLA: Usuarios
CREATE TABLE Usuarios (
    UsuarioID INT IDENTITY(1,1) PRIMARY KEY,
    Username NVARCHAR(50) NOT NULL UNIQUE,
    PasswordHash NVARCHAR(256) NOT NULL, -- La BD almacena el hash[cite: 17]
    NombreCompleto NVARCHAR(100) NOT NULL,
    Rol NVARCHAR(30) NOT NULL CHECK (Rol IN ('Recepcionista', 'Administrador'))[cite: 2, 3]
);

-- 2. TABLA: Jaulas
CREATE TABLE Jaulas (
    JaulaID NVARCHAR(10) PRIMARY KEY, -- Ej: J-01, J-07-M
    Tamaño NVARCHAR(10) NOT NULL CHECK (Tamaño IN ('P', 'M', 'G')), -- Pequeña, Mediana, Grande[cite: 7]
    TarifaDiaria DECIMAL(18, 2) NOT NULL CHECK (TarifaDiaria > 0),
    Estado NVARCHAR(20) NOT NULL DEFAULT 'Libre' CHECK (Estado IN ('Libre', 'Ocupada'))[cite: 7, 15]
);

-- 3. TABLA: Citas
CREATE TABLE Citas (
    CodigoCita NVARCHAR(20) PRIMARY KEY,
    NombreMascota NVARCHAR(50) NOT NULL,
    CedulaCliente NVARCHAR(20) NOT NULL,[cite: 2, 6]
    FechaHora DATETIME2 NOT NULL,
    Motivo NVARCHAR(200) NOT NULL,[cite: 2, 6]
    DuracionMinutos INT NOT NULL DEFAULT 30 CHECK (DuracionMinutos BETWEEN 15 AND 180),[cite: 6, 15]
    Veterinario NVARCHAR(100) NULL, -- 'Sin veterinario' o Nombre del doctor[cite: 5, 6, 15]
    Valor DECIMAL(18, 2) NOT NULL CHECK (Valor >= 0),
    Estado NVARCHAR(20) NOT NULL DEFAULT 'Programada' CHECK (Estado IN ('Programada', 'Atendida', 'Cancelada'))[cite: 2, 6, 15]
);

-- 4. TABLA: Hospitalizaciones
CREATE TABLE Hospitalizaciones (
    CodigoHospitalizacion NVARCHAR(20) PRIMARY KEY,
    NombreMascota NVARCHAR(50) NOT NULL,
    JaulaID NVARCHAR(10) NOT NULL FOREIGN KEY REFERENCES Jaulas(JaulaID),
    FechaIngreso DATETIME2 NOT NULL,
    FechaAlta DATETIME2 NULL,
    DiasCobrar INT NULL CHECK (DiasCobrar IS NULL OR DiasCobrar >= 1),[cite: 7]
    TarifaDiaria DECIMAL(18, 2) NOT NULL CHECK (TarifaDiaria > 0),[cite: 7]
    ValorTotal DECIMAL(18, 2) NULL CHECK (ValorTotal IS NULL OR ValorTotal >= 0),
    Estado NVARCHAR(20) NOT NULL DEFAULT 'Hospitalizada' CHECK (Estado IN ('Hospitalizada', 'Dada de alta'))[cite: 7, 15]
);

-- 5. TABLA: LotesMedicamento
CREATE TABLE LotesMedicamento (
    CodigoLote NVARCHAR(20) PRIMARY KEY,
    Medicamento NVARCHAR(100) NOT NULL,
    Tipo NVARCHAR(50) NOT NULL, -- Ej: Antibiótico, Vacuna, Analgésico[cite: 8]
    FechaVencimiento DATE NOT NULL,
    PrecioUnidad DECIMAL(18, 2) NOT NULL CHECK (PrecioUnidad > 0),
    Stock INT NOT NULL CHECK (Stock >= 0),[cite: 2, 8]
    VaEnNevera BIT NOT NULL DEFAULT 0 -- 1 = Sí, 0 = No[cite: 2, 8, 15]
);

-- 6. TABLA: Facturas
CREATE TABLE Facturas (
    NumeroFactura NVARCHAR(20) PRIMARY KEY,
    FechaEmision DATETIME2 NOT NULL DEFAULT GETDATE(),
    NombreCliente NVARCHAR(100) NOT NULL,
    EmitidaPorUsuarioID INT NOT NULL FOREIGN KEY REFERENCES Usuarios(UsuarioID),
    AnuladaPorUsuarioID INT NULL FOREIGN KEY REFERENCES Usuarios(UsuarioID),
    Total DECIMAL(18, 2) NOT NULL DEFAULT 0 CHECK (Total >= 0),
    Estado NVARCHAR(20) NOT NULL DEFAULT 'Vigente' CHECK (Estado IN ('Vigente', 'Anulada'))[cite: 1, 9, 11, 15]
);

-- 7. TABLA: LineasFactura
CREATE TABLE LineasFactura (
    LineaID INT IDENTITY(1,1) PRIMARY KEY,
    NumeroFactura NVARCHAR(20) NOT NULL FOREIGN KEY REFERENCES Facturas(NumeroFactura),
    TipoItem NVARCHAR(20) NOT NULL CHECK (TipoItem IN ('Cita', 'Hospitalizacion', 'Lote')),[cite: 14]
    CodigoReferencia NVARCHAR(20) NOT NULL, -- Código de Cita, Hospitalización o Lote[cite: 1, 9]
    Descripcion NVARCHAR(250) NOT NULL,[cite: 9, 14]
    Cantidad INT NOT NULL CHECK (Cantidad > 0),
    Subtotal DECIMAL(18, 2) NOT NULL CHECK (Subtotal >= 0)
);
